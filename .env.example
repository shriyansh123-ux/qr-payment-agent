QR_API_KEY=replace-with-random-at-least-24-character-secret
QR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Let visitors try synthetic QR: strings without a key (UPI/EMV and images still need it).
QR_PUBLIC_DEMO=true
# Number of reverse proxies in front of the app (0 when running locally).
QR_TRUSTED_PROXY_HOPS=0
